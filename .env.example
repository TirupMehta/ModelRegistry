# ModelRegistry environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# Neon PostgreSQL (provisioned via `neon deploy`; values come from Neon, not here).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Optional. HMAC secret for waitlist rate-limit keys. If unset, a fallback is
# used and a warning is logged; set this in production so keys cannot be
# recomputed from a guessed IP.
WAITLIST_HASH_SECRET=

# Optional rate-limit tuning (defaults: 10 attempts per 600 seconds).
WAITLIST_RATE_LIMIT_MAX=10
WAITLIST_RATE_LIMIT_WINDOW_SECONDS=600
