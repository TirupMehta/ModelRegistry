# ModelRegistry environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# Neon PostgreSQL (provisioned via `neon deploy`; values come from Neon, not here).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Canonical public base URL. Absolute URLs (canonical tags, OG images, feeds,
# JSON-LD, the snapshot manifest, agent files) are built from this one value, so
# moving to a neutral domain is one variable plus a 301 rule.
#
# NEXT_PUBLIC_* is inlined at build time: rebuild after changing it. The default
# keeps existing deployments byte-identical when the variable is unset.
NEXT_PUBLIC_SITE_URL=https://modelregistry.tirup.in

# Optional. HMAC secret for waitlist rate-limit keys. If unset, a fallback is
# used and a warning is logged; set this in production so keys cannot be
# recomputed from a guessed IP.
WAITLIST_HASH_SECRET=

# Optional rate-limit tuning (defaults: 10 attempts per 600 seconds).
WAITLIST_RATE_LIMIT_MAX=10
WAITLIST_RATE_LIMIT_WINDOW_SECONDS=600

# Snapshot signing (optional locally, required to sign in CI). Ed25519 private
# key in PEM, used by `node scripts/sign-snapshot.mjs` to sign the root SHA-256 of
# public/verify/manifest.json. Locally the key is read from the git-ignored
# .secrets/modelregistry-signing-key.pem when this is unset. Create one with
# `node scripts/generate-signing-key.mjs`; publish only the public half.
REGISTRY_SIGNING_PRIVATE_KEY=

# PostHog product analytics (optional). Create a project at posthog.com, then
# copy its Project API key here. Leave the key empty to disable analytics
# entirely: no script is loaded and no server events are sent.
#
# NEXT_PUBLIC_* values are inlined at build time, so rebuild after changing
# them. Set the host to https://eu.i.posthog.com for the EU Cloud region. The
# browser talks to /ingest on this origin; next.config.mjs proxies that path to
# the host below.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
